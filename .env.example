# Port aplikasi (hanya untuk lokal)
PORT=3500

# Password akses dashboard admin (Wajib diisi & dirahasiakan)
ADMIN_PASSWORD=admin123456

# URL Web App Google Apps Script (Wajib untuk sinkronisasi Google Sheets)
